<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seu perfil"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seu @handle (compartilhe com seus amigos):"
        android:textColor="#888888"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/handleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:padding="14dp"
        android:textColor="#5865F2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nick (nome de exibição):"
        android:textColor="#888888"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/nickInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/saveNickButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar Nick"
        android:backgroundTint="#5865F2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sair da conta"
        android:backgroundTint="#ED4245"
        android:textColor="#FFFFFF" />

</LinearLayout>
